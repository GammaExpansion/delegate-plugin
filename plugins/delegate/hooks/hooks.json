{
  "description": "Passes the conversation's permission mode to delegate tasks, and checks the command that starts one.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/permission-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
